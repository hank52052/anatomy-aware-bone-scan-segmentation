# Stage 1: masked-autoencoder pre-training (code/run_mae_pretrain_remote.py -> runs/mae_pretrain_bs80k).
# Stage 2 loads runs/mae_pretrain_bs80k/ckpt_ep099.pt (checkpoint after the last of 100 epochs).
# Recovered from the launcher that started this run; the training log confirms 7,900 images from 11 sources
# and the 3-epoch linear warm-up of bonescan.mae.cosine_warmup.
# Fixed in bonescan/mae.py: 16 x 16 patches, AdamW (weight decay 5e-5), cosine decay, gradient clipping at 5.0.
# SAVE_DIR defaults to $BONESCAN_ROOT/runs/mae_pretrain_bs80k.
EPOCHS=100
BATCH_SIZE=16
NUM_WORKERS=8
LR=1e-3
MASK_RATIO=0.6
