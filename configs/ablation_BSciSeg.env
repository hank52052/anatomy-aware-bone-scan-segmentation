# Baseline: BSci-Seg re-implementation (code/run_variant_BSciSeg_remote.py -> runs/ablation_BSciSeg/fold_k).
# Pass FOLDS=k on the command line, one fold per run.
# Recovered from the launcher of the final runs (BATCH_SIZE, NUM_WORKERS) and the training logs of all five
# folds ("lr=0.001 epochs=40 bs=8 expand=10"); EPOCHS, LR and EXPAND_FACTOR are the script defaults.
# Fixed in the script: AdamW (weight decay 5e-5) with OneCycleLR, tier1_softcp augmentation, early stopping
# after 12 epochs without improvement (from epoch 15 on), per-image intensity normalisation.
BATCH_SIZE=8
NUM_WORKERS=6
EPOCHS=40
LR=1e-3
EXPAND_FACTOR=10
VARIANT_SUFFIX=BSciSeg
