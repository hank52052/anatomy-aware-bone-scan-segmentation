# Ablation: network WITH the anatomy task but WITHOUT MAE initialisation (randomly initialised encoder)
# (code/run_simplified_remote.py -> runs/final_ours_anat_nomae/fold_k). Pass FOLDS=k on the command line.
# Identical to final_ours_anat.env except WARM_START=none, LR_ENC=1e-3 and OUT_DIR_NAME.
# Recovered from runs/final_ours_anat_nomae/fold_k/run_metadata.json (identical for the five folds apart from
# the split sizes) and from the launcher of this ablation.
OUT_DIR_NAME=final_ours_anat_nomae
LESION_SRC=meta_breast_meta,meta_prostate_meta,meta_breast_non-meta,meta_prostate_non-meta,new_mb,new_mp
ANAT_SRC=old_breast,old_prostate
WARM_START=none
BATCH_SIZE=8
NUM_WORKERS=4
LR=1e-3
# LR_ENC is recorded in run_metadata.json but not applied: bonescan.training.fit uses one AdamW parameter group,
# so the encoder trains with LR in this run and in the MAE-initialised runs alike.
LR_ENC=1e-3
EPOCHS=24
ES_PATIENCE=8
ES_MIN_EPOCHS=10
EXPAND=5
ENABLE_CVFM=0
AUG_STRENGTH=tier1_softcp
AMP_BF16=1
CUDNN_BENCH=1
