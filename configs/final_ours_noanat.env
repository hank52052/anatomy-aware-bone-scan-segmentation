# Stage 2: network WITHOUT the anatomy task (lesion-labelled scans only), encoder initialised from the MAE
# checkpoint (code/run_simplified_remote.py -> runs/final_ours_noanat/fold_k). Pass FOLDS=k on the command line.
# Identical to final_ours_anat.env except ANAT_SRC (empty = anatomy task off) and OUT_DIR_NAME.
# Recovered from runs/final_ours_noanat/fold_k/run_metadata.json (identical for the five folds apart from the
# split sizes) and from the launcher of folds 2-4.
OUT_DIR_NAME=final_ours_noanat
LESION_SRC=meta_breast_meta,meta_prostate_meta,meta_breast_non-meta,meta_prostate_non-meta,new_mb,new_mp
ANAT_SRC=
WARM_START=MAE
# MAE_CKPT defaults to $BONESCAN_ROOT/runs/mae_pretrain_bs80k/ckpt_ep099.pt
BATCH_SIZE=8
NUM_WORKERS=4
LR=1e-3
# LR_ENC is recorded in run_metadata.json but not applied: bonescan.training.fit uses one AdamW parameter group.
LR_ENC=1e-4
EPOCHS=24
ES_PATIENCE=8
ES_MIN_EPOCHS=10
EXPAND=5
ENABLE_CVFM=0
AUG_STRENGTH=tier1_softcp
AMP_BF16=1
CUDNN_BENCH=1
